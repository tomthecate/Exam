{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GateMockExamPaper",
  "type": "object",
  "required": ["paperId", "title", "questions", "schedule"],
  "properties": {
    "paperId": {
      "type": "string",
      "description": "Unique identifier for the exam paper"
    },
    "title": {
      "type": "string",
      "description": "Title of the test paper"
    },
    "subject": {
      "type": "string",
      "description": "Subject or branch name, e.g. General Aptitude / Computer Science"
    },
    "totalQuestions": {
      "type": "integer",
      "description": "Optional informational value; runtime always uses questions.length"
    },
    "totalMarks": {
      "type": "number",
      "description": "Total marks for the paper (defaults to totalQuestions * 2)"
    },
    "schedule": {
      "type": "object",
      "required": ["examDate", "startTime", "resultDate", "resultTime"],
      "properties": {
        "examDate": {
          "type": "string",
          "description": "Exam date in YYYY-MM-DD format (e.g. 2026-09-18)"
        },
        "startTime": {
          "type": "string",
          "description": "Exam start time in 24-hour HH:MM format (e.g. 21:00)"
        },
        "resultDate": {
          "type": "string",
          "description": "Date when results are declared in YYYY-MM-DD format (e.g. 2026-09-18)"
        },
        "resultTime": {
          "type": "string",
          "description": "Time when results are declared in 24-hour HH:MM format (e.g. 21:50)"
        }
      }
    },
    "markingScheme": {
      "type": "object",
      "properties": {
        "positiveMarks": { "type": "number", "default": 2 },
        "negativeMarks": { "type": "number", "default": 0.66 }
      }
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "question", "options", "correctAnswer"],
        "properties": {
          "id": { "type": "integer", "description": "Question sequence number" },
          "type": {
            "type": "string",
            "enum": ["MCQ", "MSQ", "NAT"],
            "description": "MCQ = Multiple Choice (single correct), MSQ = Multiple Select, NAT = Numerical Answer Type"
          },
          "marks": { "type": "number", "default": 2 },
          "negativeMarks": { "type": "number", "default": 0.66 },
          "question": {
            "type": "string",
            "description": "Question statement supporting inline LaTeX ($...$) and block LaTeX ($$...$$)"
          },
          "diagramSvg": {
            "type": "string",
            "description": "Optional inline SVG string for figures/charts/diagrams"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "text"],
              "properties": {
                "id": { "type": "string", "enum": ["a", "b", "c", "d"] },
                "text": { "type": "string", "description": "Option text supporting LaTeX" }
              }
            }
          },
          "correctAnswer": {
            "description": "Option id string (e.g. 'b') for MCQ, array of option ids (e.g. ['a', 'c']) for MSQ, or number/range for NAT",
            "oneOf": [
              { "type": "string" },
              { "type": "array", "items": { "type": "string" } },
              { "type": "number" },
              {
                "type": "object",
                "properties": {
                  "min": { "type": "number" },
                  "max": { "type": "number" }
                }
              }
            ]
          },
          "solution": {
            "type": "string",
            "description": "Detailed explanation with step-by-step mathematical derivation using LaTeX"
          }
        }
      }
    }
  }
}
